APP_ENV=development
SERVER_PORT=8080
DATABASE_URL=postgresql://postgres:postgres@btc-postgres:5432/btc_futures_ai_lab

OKX_INSTRUMENT=BTC-USDT-SWAP
OKX_REST_URL=https://www.okx.com
OKX_WS_PUBLIC=wss://ws.okx.com/ws/v5/public
OKX_WS_BUSINESS=wss://ws.okx.com/ws/v5/business

# Required for the manual AI analysis action; add a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_MODE=generateContent

ANALYSIS_TIMEFRAME=15m
AUTO_ANALYZE=false
AUTO_PAPER_TRADING=false

PAPER_TRADING_ONLY=true
DEFAULT_RISK_PER_TRADE=0.01
MAX_LEVERAGE=20
MAX_DAILY_LOSS_PERCENT=0.05

TIMEZONE=Asia/Ho_Chi_Minh
